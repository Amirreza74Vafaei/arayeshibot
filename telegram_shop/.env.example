# Telegram Bot Token from @BotFather
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# List of Telegram User IDs for admin access, comma-separated
# Example: ADMIN_IDS="12345678,98765432"
ADMIN_IDS="YOUR_TELEGRAM_USER_ID_HERE"

# --- Database Configuration ---
# DB_TYPE can be "sqlite" or "postgresql"
DB_TYPE="sqlite"
DB_NAME="telegram_shop.db"

# --- Optional: PostgreSQL Settings (only if DB_TYPE is "postgresql") ---
# POSTGRES_USER="user"
# POSTGRES_PASSWORD="password"
# POSTGRES_HOST="localhost"
# POSTGRES_PORT="5432"
# POSTGRES_DB="telegram_shop"

# --- Optional: Channel for Admin Notifications ---
# The ID of the channel where new order notifications will be sent.
# The bot must be an administrator in this channel.
# Example: ADMIN_CHANNEL_ID="-1001234567890"
ADMIN_CHANNEL_ID=""
