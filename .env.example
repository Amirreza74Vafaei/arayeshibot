# Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=telegram_shop
DB_HOST=db
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# FastAPI Admin Panel Configuration
ADMIN_JWT_SECRET_KEY=generate_a_strong_secret_key_here
# Example: openssl rand -hex 32

# Application Settings
ADMIN_TELEGRAM_ID=YOUR_ADMIN_TELEGRAM_ID
CONTACT_SUPPORT_LINK=YOUR_SUPPORT_CONTACT_LINK # e.g., Telegram username link
ABOUT_US_TEXT="This is an amazing bot-shop."
BRAND_NAME="My Shop"
